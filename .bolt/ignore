__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Database files
*.db
*.sqlite
*.sqlite3
src/database/

# Build artifacts
dist/
build/
*.egg-info/

# Logs
*.log
logs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

